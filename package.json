{
  "name": "meikensite-vue",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "prebuild": "tsx scripts/generate-icon-catalog.ts",
    "dev": "vite",
    "dev:worker": "npm run build && wrangler dev",
    "build": "vite build --outDir dist/client && vite build --ssr src/entry-server.ts --outDir dist/server",
    "typecheck": "wrangler types && vue-tsc --noEmit -p tsconfig.json",
    "verify:worker": "npm run build && tsx scripts/verify-worker.ts",
    "preview": "vite preview --outDir dist/client",
    "db:migrate:local": "wrangler d1 migrations apply meikensite-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply meikensite-db --remote",
    "translations:prewarm": "tsx scripts/prewarm-translations.ts",
    "deploy:worker": "wrangler deploy && npm run translations:prewarm",
    "deploy": "npm run build && npm run deploy:worker"
  },
  "dependencies": {
    "@fortawesome/fontawesome-free": "^7.3.1",
    "@vue/server-renderer": "^3.5.41",
    "markdown-it": "^15.0.0",
    "opencc-js": "^1.4.1",
    "qrcode": "^1.5.4",
    "vue": "^3.4.21",
    "vue-i18n": "^11.4.8",
    "vue-router": "^4.3.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^26.2.0",
    "@types/qrcode": "^1.5.6",
    "@vitejs/plugin-vue": "^5.0.4",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.12",
    "typescript": "~5.9.3",
    "vite": "^6.4.3",
    "vue-tsc": "^3.3.10",
    "wrangler": "^4.123.0"
  }
}
