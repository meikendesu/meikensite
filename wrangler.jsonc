{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "meikensite",
	"main": "worker.ts",
	"compatibility_date": "2026-08-15",
	"compatibility_flags": [
		"nodejs_compat"
	],
	"assets": {
		"directory": "./dist/client",
		"binding": "ASSETS"
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "meikensite-db",
			"database_id": "4bdb105d-7137-48a5-a755-41e4883d1da8",
			"migrations_dir": "migrations"
		}
	],
	"ai": {
		"binding": "AI",
		"remote": true
	},
	"observability": {
		"enabled": true,
		"head_sampling_rate": 1
	}
}
